{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"dist/**"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"test": {
			"dependsOn": [
				"^test"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"deploy": {
			"cache": false,
			"passThroughEnv": [
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_ACCOUNT_ID",
				"ALCHEMY_STATE_TOKEN",
				"VITE_SERVER_URL",
				"CORS_ORIGIN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"POLAR_ACCESS_TOKEN",
				"POLAR_SUCCESS_URL",
				"ALCHEMY_PASSWORD"
			]
		},
		"destroy": {
			"cache": false,
			"passThroughEnv": [
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_ACCOUNT_ID",
				"ALCHEMY_STATE_TOKEN"
			]
		}
	}
}